@model WebApplication.Models.BienImmobilier

@{
    ViewData["Title"] = "Modifier le bien";
}

<div class="container mt-4" style="max-width: 950px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Catalogue</a></li>
            <li class="breadcrumb-item active" aria-current="page">Modifier le bien</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark p-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square"></i> Modification du bien : @Model.Titre</h4>
        </div>
        <div class="card-body p-4 bg-light">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 border-end">
                        <div class="mb-3">
                            <label asp-for="Titre" class="form-label fw-bold">Titre de l'annonce</label>
                            <input asp-for="Titre" class="form-control" placeholder="Titre de l'annonce" />
                            <span asp-validation-for="Titre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="6" placeholder="Propre..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Prix" class="form-label fw-bold">Prix</label>
                                <div class="input-group">
                                    <input asp-for="Prix" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">€</span>
                                </div>
                                <span asp-validation-for="Prix" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Surface" class="form-label fw-bold">Surface</label>
                                <div class="input-group">
                                    <input asp-for="Surface" type="number" class="form-control" />
                                    <span class="input-group-text">m²</span>
                                </div>
                                <span asp-validation-for="Surface" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Ville" class="form-label fw-bold">Ville</label>
                            <input asp-for="Ville" class="form-control" />
                            <span asp-validation-for="Ville" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Type" class="form-label fw-bold">Type de bien</label>
                            <select asp-for="Type" class="form-select">
                                <option value="Maison">Maison</option>
                                <option value="Appartement">Appartement</option>
                                <option value="Terrain">Terrain</option>
                            </select>
                            <span asp-validation-for="Type" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AgenceId" class="form-label fw-bold">Agence de référence</label>
                            <select asp-for="AgenceId" class="form-select">
                                <option value="1">Siège social - Aix-en-Provence</option>
                                <option value="2">Agence - Paris Centre</option>
                                <option value="3">Agence - Lyon Lumière</option>
                                <option value="4">Agence - Marseille Vieux-Port</option>
                                <option value="5">Agence - Bordeaux Quinconces</option>
                                <option value="6">Agence - Lille Grand-Place</option>
                                <option value="7">Agence - Nantes Machines</option>
                                <option value="8">Agence - Strasbourg Europe</option>
                                <option value="9">Agence - Toulouse Capitole</option>
                                <option value="10">Agence - Nice Promenade</option>
                                <option value="11">Agence - Rennes République</option>
                                <option value="12">Agence - Montpellier Comédie</option>
                            </select>
                            <span asp-validation-for="AgenceId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label fw-bold">Lien URL de l'image</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/photo-..." />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="text-muted text-decoration-none small">Retour sans enregistrer</a>
                    <button type="submit" class="btn btn-warning fw-bold px-4 shadow-sm">Enregistrer les modifications</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}