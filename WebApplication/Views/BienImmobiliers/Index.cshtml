@model IEnumerable<WebApplication.Models.BienImmobilier>

@{
    ViewData["Title"] = "Nos Biens Immobiliers";
}

<div class="container mt-4">
    @if (User.Identity.IsAuthenticated)
    {
        <div class="d-flex justify-content-end mb-3">
            <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">
                <i class="bi bi-plus-circle"></i> Ajouter un nouveau bien
            </a>
        </div>
    }

    <form method="get" asp-action="Index" class="card p-3 shadow-sm border-0 mb-4 bg-light">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Recherche libre</label>
                <input type="text" name="recherche" value="@Context.Request.Query["recherche"]" class="form-control" placeholder="Ex: Jardin, calme..." />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">Ville</label>
                <input type="text" name="ville" value="@Context.Request.Query["ville"]" class="form-control" placeholder="Ex: Aix-en-Provence" />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">Type</label>
                <select name="type" class="form-select">
                    <option value="">Tous les types</option>
                    <option value="Maison" selected="@(Context.Request.Query["type"] == "Maison" ? "selected" : null)">Maison</option>
                    <option value="Appartement" selected="@(Context.Request.Query["type"] == "Appartement" ? "selected" : null)">Appartement</option>
                    <option value="Terrain" selected="@(Context.Request.Query["type"] == "Terrain" ? "selected" : null)">Terrain</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Agence Ymmo référente</label>
                <select name="agenceId" class="form-select">
                    <option value="">Toutes les agences</option>
                    <option value="1" selected="@(Context.Request.Query["agenceId"] == "1" ? "selected" : null)">Siège social - Aix-en-Provence</option>
                    <option value="2" selected="@(Context.Request.Query["agenceId"] == "2" ? "selected" : null)">Agence - Paris Centre</option>
                    <option value="3" selected="@(Context.Request.Query["agenceId"] == "3" ? "selected" : null)">Agence - Lyon Lumière</option>
                    <option value="4" selected="@(Context.Request.Query["agenceId"] == "4" ? "selected" : null)">Agence - Marseille Vieux-Port</option>
                    <option value="5" selected="@(Context.Request.Query["agenceId"] == "5" ? "selected" : null)">Agence - Bordeaux Quinconces</option>
                    <option value="6" selected="@(Context.Request.Query["agenceId"] == "6" ? "selected" : null)">Agence - Lille Grand-Place</option>
                    <option value="7" selected="@(Context.Request.Query["agenceId"] == "7" ? "selected" : null)">Agence - Nantes Machines</option>
                    <option value="8" selected="@(Context.Request.Query["agenceId"] == "8" ? "selected" : null)">Agence - Strasbourg Europe</option>
                    <option value="9" selected="@(Context.Request.Query["agenceId"] == "9" ? "selected" : null)">Agence - Toulouse Capitole</option>
                    <option value="10" selected="@(Context.Request.Query["agenceId"] == "10" ? "selected" : null)">Agence - Nice Promenade</option>
                    <option value="11" selected="@(Context.Request.Query["agenceId"] == "11" ? "selected" : null)">Agence - Rennes République</option>
                    <option value="12" selected="@(Context.Request.Query["agenceId"] == "12" ? "selected" : null)">Agence - Montpellier Comédie</option>
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">
                    <i class="bi bi-search"></i> Filtrer
                </button>
            </div>
        </div>
    </form>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Titre" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-primary">@item.Type</span>
                            <h5 class="text-primary fw-bold mb-0">@item.Prix.ToString("N0") €</h5>
                        </div>
                        <h5 class="card-title fw-bold text-truncate">@item.Titre</h5>
                        <p class="text-muted small mb-3"><i class="bi bi-geo-alt"></i> @item.Ville</p>
                        <p class="card-text text-truncate">@item.Description</p>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fw-bold"><i class="bi bi-arrows-fullscreen"></i> @item.Surface m²</span>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm">Découvrir</a>
                        </div>
                    </div>
                    
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="card-footer bg-white border-top-0 pb-3 d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm flex-grow-1"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm text-danger flex-grow-1"><i class="bi bi-trash"></i></a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>