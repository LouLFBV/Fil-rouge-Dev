@model WebApplication.Models.BienImmobilier

@{
    ViewData["Title"] = "Ajouter un Bien";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour au catalogue
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white p-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-house-add"></i> Enregistrer un nouveau bien</h4>
        </div>
        <div class="card-body p-4 bg-light">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Titre" class="form-label fw-bold">Titre de l'annonce</label>
                    <input asp-for="Titre" class="form-control" placeholder="Ex: Magnifique Villa T5 avec piscine" />
                    <span asp-validation-for="Titre" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Type" class="form-label fw-bold">Type de bien</label>
                        <select asp-for="Type" class="form-select">
                            <option value="Maison">Maison</option>
                            <option value="Appartement">Appartement</option>
                            <option value="Terrain">Terrain</option>
                        </select>
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Prix" class="form-label fw-bold">Prix (€)</label>
                        <div class="input-group">
                            <input asp-for="Prix" type="number" class="form-control" placeholder="Montant" />
                            <span class="input-group-text">€</span>
                        </div>
                        <span asp-validation-for="Prix" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Ville" class="form-label fw-bold">Ville</label>
                        <input asp-for="Ville" class="form-control" placeholder="Ex: Aix-en-Provence" />
                        <span asp-validation-for="Ville" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Surface" class="form-label fw-bold">Surface (m²)</label>
                        <div class="input-group">
                            <input asp-for="Surface" type="number" class="form-control" placeholder="Superficie" />
                            <span class="input-group-text">m²</span>
                        </div>
                        <span asp-validation-for="Surface" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="AgenceId" class="form-label fw-bold">Rattacher à une agence Ymmo</label>
                    <select asp-for="AgenceId" class="form-select">
                        <option value="1">Siège social - Aix-en-Provence</option>
                        <option value="2">Agence - Paris Centre</option>
                        <option value="3">Agence - Lyon Lumière</option>
                        <option value="4">Agence - Marseille Vieux-Port</option>
                        <option value="5">Agence - Bordeaux Quinconces</option>
                        <option value="6">Agence - Lille Grand-Place</option>
                        <option value="7">Agence - Nantes Machines</option>
                        <option value="8">Agence - Strasbourg Europe</option>
                        <option value="9">Agence - Toulouse Capitole</option>
                        <option value="10">Agence - Nice Promenade</option>
                        <option value="11">Agence - Rennes République</option>
                        <option value="12">Agence - Montpellier Comédie</option>
                    </select>
                    <span asp-validation-for="AgenceId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Description du bien</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Détaillez les prestations du bien..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label fw-bold">Lien URL de la photo</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="Ex: https://images.unsplash.com/photo-..." />
                    <span class="form-text text-muted small">Copiez-collez l'adresse d'une image du web pour illustrer votre annonce.</span>
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm">
                        <i class="bi bi-check-circle"></i> Publier l'annonce
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}